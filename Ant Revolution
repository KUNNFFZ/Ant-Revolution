local RollRemote = Remotes and Remotes:FindFirstChild("RollMutation")
local function rollOnce()
    if not RollRemote then return false, "ไม่พบ remote RollMutation" end
    local n = math.floor(tonumber(Hub.Flags.RollCount) or 1)
    if n ~= 1 and n ~= 5 then n = 1 end
    local tokens = math.max(0, math.floor(tonumber(P:GetAttribute("RollTokens")) or 0))
    local dna = math.max(0, math.floor(tonumber(P:GetAttribute("DNA")) or 0))
    local usable = math.max(0, dna - math.max(0, math.floor(tonumber(Hub.Flags.RollReserve) or 0)))
    local available = tokens + math.floor(usable / math.max(1, RollCost))
    if available < n then
        return false, string.format("ของไม่พอ (Token %d + DNA %d/%d = %d รอบ ต้อง %d)",
            tokens, usable, RollCost, available, n)
    end
    local ok, res = pcall(function() return RollRemote:InvokeServer(n) end)
    if not ok then return false, "err: " .. tostring(res) end
    if type(res) ~= "table" or not res.ok then
        local msg = tostring(type(res) == "table" and (res.msg or "ไม่สำเร็จ") or res)
        if msg:lower():find("slow") then Hub.SlowUntil = os.clock() + 2.5 end
        return false, msg
    end
    Hub.Stats.rolls += n
    local notes, bestRank, bestKey = {}, 0, nil
    for _, v in pairs(res.results or {}) do
        if type(v) == "table" then
            local key = tostring(v.key or "?")
            local rar = tostring(v.rarity or "?")
            local rank = RARITY_RANK[rar] or 0
            if rank > bestRank then bestRank, bestKey = rank, rar end
            if v.new == true then Hub.Stats.rollNew += 1 end
            if tonumber(v.refund) then Hub.Stats.rollRefund += tonumber(v.refund) end
            notes[#notes + 1] = string.format("%s(%s)%d★%s", key, rar, tonumber(v.stars) or 1,
                v.new and " NEW" or "")
        end
    end
    table.sort(notes)
    local stopMin = RARITY_MIN[Hub.Flags.RollStop]
    if stopMin and bestRank >= stopMin then
        Hub.Flags.AutoRoll = false
        return true, string.format("ได้ %s! หยุดอัตโนมัติ | %s", bestKey, table.concat(notes, ", "))
    end
    return true, string.format("%d รอบ: %s", n, table.concat(notes, ", "))
end

