            task.wait(gap)
        end
        local ok4, r4 = invoke("ClaimQuest", "bonus")
        if ok4 and type(r4) == "table" and r4.ok then got += 1; note("Q bonus") end
        task.wait(gap)
    end
    if Hub.Flags.ClaimRecords then
        local keys = {}
        if Config and type(Config.RecordByKey) == "table" then
            for k in pairs(Config.RecordByKey) do keys[#keys + 1] = k end
        else
