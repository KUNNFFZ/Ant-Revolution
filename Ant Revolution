local function weakerThanMe(m, myHp, myStage)
    local hp = tonumber(m:GetAttribute("HP")) or 0
    local mx = tonumber(m:GetAttribute("MaxHP")) or hp
    local st = tonumber(m:GetAttribute("Stage")) or 0
    local limit = myHp * (Hub.Flags.CbRatio or 1)
    local hpOk = hp > 0 and hp < limit and mx <= limit
    local stOk = st > 0 and st < myStage
    local mode = Hub.Flags.CbMode
    if mode == "Stage ต่ำกว่า" then return stOk end
    if mode == "HP+Stage" then return hpOk and stOk end
    return hpOk
end
local function pickTarget(me, hrp, myHp, myStage)
    local now = WS:GetServerTimeNow()
    if CB.target and CB.target.m and CB.target.m.Parent and os.clock() < CB.stickyUntil then
        local t = CB.target
        if t.m:GetAttribute("Dead") ~= true and weakerThanMe(t.m, myHp, myStage) and mobAllowed(t.m) then
            local ev = tonumber(t.m:GetAttribute("Evolving"))
            if not (ev and ev > now) and t.r and t.r.Parent
                and (t.r.Position - hrp.Position).Magnitude <= (Hub.Flags.CbRange or 250) then return t end
        end
    end
    local best, bestScore = nil, nil
    for _, m in ipairs(CS:GetTagged("Creature")) do
        if m:IsA("Model") and m ~= me and m:GetAttribute("Dead") ~= true then
            local isBot = m:GetAttribute("IsBot") == true
            local isCrit = m:GetAttribute("IsCritter") == true
            local allowed = false
            if isBot and Hub.Flags.CbBots then allowed = true end
            if isCrit and Hub.Flags.CbCritters then allowed = true end
            if not isBot and not isCrit and Hub.Flags.CbPlayers then allowed = true end
            if allowed and mobAllowed(m) and weakerThanMe(m, myHp, myStage) then
                local ev = tonumber(m:GetAttribute("Evolving"))
                local inv = tonumber(m:GetAttribute("InvisUntil"))
                local stateOk = not (ev and ev > now) and not (inv and inv > now)
                if stateOk then
                    local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
                    if r and r:IsA("BasePart") then
                        local d = (r.Position - hrp.Position).Magnitude
                        if d <= (Hub.Flags.CbRange or 250) then
                            local hp = tonumber(m:GetAttribute("HP")) or 0
                            local st = tonumber(m:GetAttribute("Stage")) or 0
                            local score = d
                            if Hub.Flags.CbPriority == "HP น้อยสุด" then score = hp
                            elseif Hub.Flags.CbPriority == "Stage ต่ำสุด" then score = st * 1000 + d end
                            if not bestScore or score < bestScore then
                                bestScore = score
                                best = { m = m, r = r, id = m:GetAttribute("EntityId"), hp = hp, st = st, d = d }
                            end
                        end
                    end
                end
            end
        end
    end
    CB.target = best
    return best
end
