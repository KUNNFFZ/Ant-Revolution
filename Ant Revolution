        if Hub.Flags.Combat then
            pcall(function()
                if not BiteRemote then Hub.Msg.Cb = "ไม่พบ remote Bite" return end
                if os.clock() < (Hub.EvHoldUntil or 0) then Hub.Msg.Cb = "พัก (กำลัง evolve/rebirth)" return end
                local me, hrp = getHRP()
                if not hrp then return end
                if me:GetAttribute("Dead") == true then Hub.Msg.Cb = "รอเกิดใหม่..." return end
                if me:GetAttribute("Kind") == "Egg" then Hub.Msg.Cb = "ร่างไข่กัดไม่ได้" return end
                local now = WS:GetServerTimeNow()
                local ev = tonumber(me:GetAttribute("Evolving"))
                if ev and ev > now then Hub.Msg.Cb = "รอ evolve เสร็จ..." return end
                local myHp = tonumber(me:GetAttribute("HP")) or 0
                local myStage = tonumber(me:GetAttribute("Stage")) or 1
                local t = pickTarget(me, hrp, myHp, myStage)
                if not t then Hub.Msg.Cb = "ไม่พบเป้าที่อ่อนกว่า (ตรงตัวกรอง)" return end
                if CB.lastId ~= nil and t.id ~= CB.lastId then
                    local prev = CB.target
                    if prev and prev.m then
                        local cur = tonumber(prev.m:GetAttribute("HP")) or 0
                        if cur <= 0 or prev.m:GetAttribute("Dead") == true then Hub.Stats.kills += 1 end
                    end
                end
                local pos = t.r.Position
                if Hub.Flags.CbWarp then hrp.CFrame = CFrame.lookAt(pos + Vector3.new(0, 0.5, 2.4), pos)
                else hrp.CFrame = CFrame.lookAt(hrp.Position, pos) end
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                CB.stickyUntil = os.clock() + 2
                if os.clock() - CB.lastBite >= (Hub.Flags.CbGap or 0.6) then
                    local fired = pcall(function() BiteRemote:FireServer(t.id) end)
                    if fired then
                        CB.lastBite = os.clock(); CB.lastId = t.id
                        Hub.Stats.hits += 1
                        Hub.Msg.Cb = string.format("กัด %s HP %s Stage %s",
                            tostring(t.m:GetAttribute("Species") or t.m.Name), tostring(t.hp), tostring(t.st))
                    else Hub.Msg.Cb = "ยิง Bite ไม่สำเร็จ" end
                end
            end)
        end
        task.wait(0.1)
    end
end)

task.spawn(function()
    while Hub.Running do
        local paused = Hub.Flags.Combat and Hub.Flags.CbPauseFarm
        if Hub.Flags.Farm and not paused then
            local ok = pcall(function()
                if os.clock() < (Hub.EvHoldUntil or 0) then Hub.Msg.Orb = "พักวาร์ป (evolve/rebirth)" return end
                local _, hrp = getHRP()
                if not hrp then return end
                if P:GetAttribute("Dead") == true then return end
                local st = findState()
                if not st then Hub.Msg.Orb = "หา state ออร์บไม่เจอ (รีสแกน)" return end
                local now, here = os.clock(), hrp.Position
                local best, bestId, bestD, total = nil, nil, nil, 0
                for id, o in pairs(st.orbs) do
                    total += 1
                    if typeof(o.pos) == "Vector3" and (o.state == "field" or o.state == "spawn") then
                        local skipT = S.skipped[id]
                        if not skipT or now - skipT > 6 then
                            local d = (o.pos - here).Magnitude
                            if not bestD or d < bestD then bestD, best, bestId = d, o, id end
                        end
                    end
                end
                if total == 0 then S.t2 = nil; Hub.Msg.Orb = "ไม่พบออร์บ (รีสแกน)" return end
                if not best then Hub.Msg.Orb = "ออร์บใกล้ตัวถูกสคิปชั่วคราว" return end
                warpTo(hrp, best.pos, Hub.Flags.Delay or 0.05)
                local t0 = os.clock()
                while os.clock() - t0 < (Hub.Flags.Settle or 0.15) do
                    if not hrp.Parent then return end
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    task.wait(0.03)
                end
                if st.orbs[bestId] then S.skipped[bestId] = os.clock() end
                Hub.Stats.warps += 1
            end)
            if not ok then S.t2 = nil end
        end
        task.wait(Hub.Flags.Delay or 0.05)
    end
end)

