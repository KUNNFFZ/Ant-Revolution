-- ===================================================================
-- รวม 2 สคริปต์ในไฟล์เดียว: [1] MouSey Base Menu  [2] 2K Ant Evolution
-- ===================================================================

-- ===== [1] MouSey Hub | Base Menu =====
do
if getgenv().MouSeyBase then pcall(getgenv().MouSeyBase.Stop) end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local LP = Players.LocalPlayer

local Hub = {
    Running = true,
    Binding = false,
    Conns = {},
    Opts = {
        MenuKey = Enum.KeyCode.RightShift,
        MenuSize = Vector2.new(540, 340),
        Notify = true,
    },
    Content = nil,
}
getgenv().MouSeyBase = Hub

local MIN_W, MIN_H = 420, 260
local MAX_W, MAX_H = 900, 640

local T = {
    bg = Color3.fromRGB(10, 10, 12),
    panel = Color3.fromRGB(18, 18, 21),
    line = Color3.fromRGB(42, 42, 50),
    text = Color3.fromRGB(236, 236, 242),
    dim = Color3.fromRGB(128, 128, 138),
}

local function track(c) table.insert(Hub.Conns, c) return c end

local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function stroke(p, col, tr) return new("UIStroke", { Color = col or T.line, Transparency = tr or 0, Thickness = 1 }, p) end
local function tween(o, goal, t) TweenService:Create(o, TweenInfo.new(t or 0.2, Enum.EasingStyle.Quint), goal):Play() end
local function label(parent, text, size, pos, color, font, xa)
    return new("TextLabel", {
        BackgroundTransparency = 1, Size = size, Position = pos or UDim2.new(),
        Text = text, TextColor3 = color or T.text, TextSize = 13,
        Font = font or Enum.Font.GothamMedium, TextXAlignment = xa or Enum.TextXAlignment.Left,
    }, parent)
end

local function getGuiParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then return cg end
    return LP:WaitForChild("PlayerGui")
end

local gui = new("ScreenGui", {
    Name = "MouSeyHub", ResetOnSpawn = false,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true,
}, getGuiParent())

local function fullSize() return UDim2.fromOffset(Hub.Opts.MenuSize.X, Hub.Opts.MenuSize.Y) end
local minimized = false

local main = new("Frame", {
    Size = fullSize(), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
    BackgroundColor3 = T.bg, BorderSizePixel = 0, ClipsDescendants = true,
}, gui)
corner(main, 12); stroke(main)
new("UIGradient", {
    Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 0, 0)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
    }),
    Rotation = 90,
}, main)

local top = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, main)
label(top, "MouSey Hub", UDim2.new(0, 110, 1, 0), UDim2.fromOffset(16, 0), T.text, Enum.Font.GothamBold)
local gameTitle = label(top, "[🐜] Ant Evolution", UDim2.new(1, 0, 1, 0), UDim2.fromOffset(40, 0), T.text, Enum.Font.GothamBold)
gameTitle.TextXAlignment = Enum.TextXAlignment.Center
gameTitle.ZIndex = 2
new("Frame", { Size = UDim2.new(1, 0, 0, 1), Position = UDim2.fromOffset(0, 40), BackgroundColor3 = T.line, BorderSizePixel = 0 }, main)

local function iconBtn(parent, txt, x)
    local b = new("TextButton", {
        Size = UDim2.fromOffset(26, 26), Position = UDim2.new(1, x, 0.5, -13),
        BackgroundColor3 = T.panel, BorderSizePixel = 0, AutoButtonColor = false,
        Text = txt, TextColor3 = T.dim, TextSize = 16, Font = Enum.Font.GothamBold,
    }, parent)
    corner(b, 7); stroke(b)
    b.MouseEnter:Connect(function() tween(b, { TextColor3 = T.text }, 0.15) end)
    b.MouseLeave:Connect(function() tween(b, { TextColor3 = T.dim }, 0.15) end)
    return b
end
local minBtn = iconBtn(top, "–", -66)
local closeBtn = iconBtn(top, "×", -34)

local body = new("Frame", { Size = UDim2.new(1, 0, 1, -41), Position = UDim2.fromOffset(0, 41), BackgroundTransparency = 1 }, main)
local side = new("Frame", { Size = UDim2.new(0, 92, 1, 0), BackgroundTransparency = 1 }, body)
new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.fromOffset(92, 0), BackgroundColor3 = T.line, BorderSizePixel = 0 }, body)

-- NOTE: content scale is no longer driven by window size (avoids overshooting)
local content = new("Frame", { Size = UDim2.new(1, -92, 1, 0), Position = UDim2.fromOffset(92, 0), BackgroundTransparency = 1, ClipsDescendants = true }, body)
Hub.Content = content

local pfp = new("ImageLabel", {
    Size = UDim2.fromOffset(40, 40), Position = UDim2.new(0.5, -20, 0, 6),
    BackgroundColor3 = T.panel, BorderSizePixel = 0,
}, side)
corner(pfp, 20); stroke(pfp)
task.spawn(function()
    local ok, img = pcall(Players.GetUserThumbnailAsync, Players, LP.UserId,
        Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    if ok then pfp.Image = img end
end)
local pfpName = label(side, LP.Name, UDim2.new(1, 0, 0, 12), UDim2.fromOffset(0, 50), T.dim, Enum.Font.Gotham, Enum.TextXAlignment.Center)
pfpName.TextSize = 10
pfpName.TextTruncate = Enum.TextTruncate.AtEnd

local dragging, dragStart, startPos
top.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging, dragStart, startPos = true, i.Position, main.Position
    end
end)
track(UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end))
track(UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

local grip = new("TextButton", {
    Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -2, 1, -2), BackgroundTransparency = 1,
    Text = "◢", TextColor3 = T.dim, TextSize = 12, Font = Enum.Font.GothamBold,
    AutoButtonColor = false, ZIndex = 20,
}, main)
local resizing, rStart, rSize
grip.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        resizing, rStart, rSize = true, i.Position, Hub.Opts.MenuSize
    end
end)
track(UIS.InputChanged:Connect(function(i)
    if resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - rStart
        Hub.Opts.MenuSize = Vector2.new(
            math.clamp(rSize.X + d.X, MIN_W, MAX_W),
            math.clamp(rSize.Y + d.Y, MIN_H, MAX_H))
        if not minimized then main.Size = fullSize() end
    end
end))
track(UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        resizing = false
    end
end))

minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    body.Visible = not minimized
    grip.Visible = not minimized
    minBtn.Text = minimized and "+" or "–"
    tween(main, { Size = minimized and UDim2.fromOffset(Hub.Opts.MenuSize.X, 40) or fullSize() }, 0.25)
end)

closeBtn.MouseButton1Click:Connect(function() Hub.Stop() end)

track(UIS.InputBegan:Connect(function(i, gp)
    if gp or Hub.Binding then return end
    if i.KeyCode == Hub.Opts.MenuKey then
        main.Visible = not main.Visible
    end
end))

local float = new("TextButton", {
    Size = UDim2.fromOffset(44, 44), Position = UDim2.new(0, 16, 0.5, -22),
    BackgroundColor3 = T.bg, BorderSizePixel = 0, AutoButtonColor = false,
    Text = "M", TextColor3 = T.text, TextSize = 18, Font = Enum.Font.GothamBold, ZIndex = 50,
}, gui)
corner(float, 10); stroke(float)

local fDrag, fStart, fPos, fMoved = false, nil, nil, false
float.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        fDrag, fStart, fPos, fMoved = true, i.Position, float.Position, false
    end
end)
track(UIS.InputChanged:Connect(function(i)
    if fDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - fStart
        if math.abs(d.X) + math.abs(d.Y) > 4 then fMoved = true end
        float.Position = UDim2.new(fPos.X.Scale, fPos.X.Offset + d.X, fPos.Y.Scale, fPos.Y.Offset + d.Y)
    end
end))
track(UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        if fDrag and not fMoved then main.Visible = not main.Visible end
        fDrag = false
    end
end))

local notifyHolder = new("Frame", {
    Size = UDim2.fromOffset(280, 0), AnchorPoint = Vector2.new(1, 1),
    Position = UDim2.new(1, -16, 1, -16), BackgroundTransparency = 1,
    AutomaticSize = Enum.AutomaticSize.Y, ZIndex = 200,
}, gui)
new("UIListLayout", {
    Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder,
    VerticalAlignment = Enum.VerticalAlignment.Bottom,
}, notifyHolder)

local notifyOrder = 0
function Hub.Notify(_, o)
    if type(o) ~= "table" or Hub.Opts.Notify == false then return end
    notifyOrder = notifyOrder + 1
    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.panel, BorderSizePixel = 0, LayoutOrder = -notifyOrder, ZIndex = 200,
    }, notifyHolder)
    corner(card, 8); stroke(card)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
    }, card)
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, card)
    local title = label(card, tostring(o.Title or ""), UDim2.new(1, 0, 0, 14), nil, T.text, Enum.Font.GothamBold)
    title.ZIndex = 201
    local text = label(card, tostring(o.Text or ""), UDim2.new(1, 0, 0, 0), nil, T.dim, Enum.Font.Gotham)
    text.AutomaticSize = Enum.AutomaticSize.Y
    text.TextWrapped = true
    text.ZIndex = 201
    task.delay(tonumber(o.Duration) or 3, function()
        if card and card.Parent then
            tween(card, { BackgroundTransparency = 1 }, 0.3)
            task.wait(0.3)
            pcall(function() card:Destroy() end)
        end
    end)
end

task.spawn(function()
    while Hub.Running do
        if not (gui and gui.Parent) then
            gui = new("ScreenGui", {
                Name = "MouSeyHub", ResetOnSpawn = false,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = true,
            }, getGuiParent())
            main.Parent = gui
            float.Parent = gui
            notifyHolder.Parent = gui
        end
        task.wait(1)
    end
end)

local function playIntro()
    local introLabel = new("TextLabel", {
        Size = UDim2.fromOffset(600, 120), Position = UDim2.fromScale(0.5, 0.5),
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1,
        Text = "MouSey", TextColor3 = T.text, TextSize = 100, Font = Enum.Font.GothamBold,
        TextTransparency = 1, ZIndex = 100,
    }, gui)
    local scale = new("UIScale", { Scale = 0.8 }, introLabel)
    local glow = new("UIStroke", {
        Color = Color3.fromRGB(255, 255, 255), Thickness = 6,
        Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, introLabel)
    local glow2 = new("UIStroke", {
        Color = Color3.fromRGB(180, 220, 255), Thickness = 14,
        Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, introLabel)

    main.Visible = false
    float.Visible = false

    tween(introLabel, { TextTransparency = 0 }, 1)
    tween(scale, { Scale = 1 }, 0.5)
    tween(glow, { Transparency = 0.2 }, 0.8)
    tween(glow2, { Transparency = 0.6 }, 0.8)
    task.wait(0.8)
    for _ = 1, 3 do
        tween(glow2, { Transparency = 0.8 }, 0.35)
        task.wait(0.35)
        tween(glow2, { Transparency = 0.5 }, 0.35)
        task.wait(0.35)
    end
    tween(glow, { Transparency = 1 }, 0.5)
    tween(glow2, { Transparency = 1 }, 0.5)
    tween(introLabel, { TextTransparency = 1 }, 0.8)
    tween(scale, { Scale = 1.1 }, 0.6)
    task.wait(0.6)
    introLabel:Destroy()

    main.Visible = true
    float.Visible = true
    local mainScale = main:FindFirstChildOfClass("UIScale") or new("UIScale", { Scale = 0.9 }, main)
    mainScale.Scale = 0.9
    tween(mainScale, { Scale = 1 }, 0.35)
end

function Hub.Stop()
    Hub.Running = false
    for _, c in ipairs(Hub.Conns) do pcall(function() c:Disconnect() end) end
    Hub.Conns = {}
    pcall(function() gui:Destroy() end)
    if getgenv().MouSeyBase == Hub then getgenv().MouSeyBase = nil end
end

task.spawn(function() pcall(playIntro) end)
end -- ===== จบ [1] =====

-- ===== [2] 2K | Ant Evolution =====
do
if getgenv().TwoK then pcall(getgenv().TwoK.Stop) end
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local CS = game:GetService("CollectionService")
local WS = game:GetService("Workspace")
local P = Players.LocalPlayer
local Remotes = RS:FindFirstChild("AntRemotes")

local MouseyBase = getgenv().MouSeyBase
if not MouseyBase or not MouseyBase.Content then
    warn("[2K] ยังไม่มี MouSey base menu ให้รัน base ก่อน")
    return
end

local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local C = {
    panel = Color3.fromRGB(18, 18, 21), line = Color3.fromRGB(42, 42, 50),
    text = Color3.fromRGB(236, 236, 242), dim = Color3.fromRGB(128, 128, 138),
    off = Color3.fromRGB(52, 52, 60), on = Color3.fromRGB(246, 246, 250),
    bg = Color3.fromRGB(10, 10, 12),
}
local uiConns = {}
local function mk(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function rnd(p, r) mk("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function strk(p) mk("UIStroke", { Color = C.line, Thickness = 1 }, p) end
local function tw(o, goal, t)
    TweenService:Create(o, TweenInfo.new(t or 0.15, Enum.EasingStyle.Quint), goal):Play()
end
local function lbl(parent, text, size, pos, color, font, xa)
    return mk("TextLabel", {
        BackgroundTransparency = 1, Size = size, Position = pos or UDim2.new(), Text = text,
        TextColor3 = color or C.text, TextSize = 13, Font = font or Enum.Font.GothamMedium,
        TextXAlignment = xa or Enum.TextXAlignment.Left,
    }, parent)
end

local uiRoot = mk("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, MouseyBase.Content)
local tabBar = mk("Frame", { Size = UDim2.new(1, -12, 0, 26), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 1 }, uiRoot)
mk("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, tabBar)
local pageHolder = mk("Frame", { Size = UDim2.new(1, -12, 1, -74), Position = UDim2.fromOffset(6, 38), BackgroundTransparency = 1, ClipsDescendants = true }, uiRoot)
local statusLbl = mk("TextLabel", {
    BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 1, -34),
    Text = "-", TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 10, TextWrapped = true,
    TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
}, uiRoot)

local tabs, tabCount, activeTab = {}, 0, nil
local function selectTab(name)
    for n, t in pairs(tabs) do
        local on = (n == name)
        t.page.Visible = on
        tw(t.btn, { BackgroundColor3 = on and C.panel or C.bg, TextColor3 = on and C.text or C.dim }, 0.15)
    end
    activeTab = name
end

local function newSection(page, title)
    local order = 0
    local function nextOrder() order += 1; return order end
    local card = mk("Frame", {
        Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = C.panel, BorderSizePixel = 0, LayoutOrder = nextOrder() + 1000,
    }, page)
    rnd(card, 10); strk(card)
    mk("UIPadding", {
        PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10),
    }, card)
    mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, card)
    lbl(card, title, UDim2.new(1, 0, 0, 14), nil, C.dim, Enum.Font.GothamBold).LayoutOrder = 0

    local sec = {}

    function sec:Toggle(opt)
        local state = opt.Default == true
        local row = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, Text = "",
            AutoButtonColor = false, LayoutOrder = nextOrder(),
        }, card)
        lbl(row, opt.Name or "", UDim2.new(1, -50, 1, 0))
        local glow = mk("Frame", {
            Size = UDim2.fromOffset(46, 26), AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 5, 0.5, 0), BackgroundColor3 = C.on,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
        }, row)
        rnd(glow, 13)
        local track = mk("Frame", {
            Size = UDim2.fromOffset(36, 18), AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = C.off, BorderSizePixel = 0, ZIndex = 2,
        }, row)
        rnd(track, 9)
        local knob = mk("Frame", { Size = UDim2.fromOffset(14, 14), BackgroundColor3 = C.dim, BorderSizePixel = 0, ZIndex = 3 }, track)
        rnd(knob, 7)
        local function render(anim)
            local t = anim and 0.15 or 0
            tw(track, { BackgroundColor3 = state and C.on or C.off }, t)
            tw(knob, {
                Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                BackgroundColor3 = state and C.bg or C.dim,
            }, t)
            tw(glow, { BackgroundTransparency = state and 0.86 or 1 }, t)
        end
        render(false)
        row.MouseButton1Click:Connect(function()
            state = not state
            render(true)
            if opt.Callback then opt.Callback(state) end
        end)
    end

    function sec:Slider(opt)
        local mn, mx, step = opt.Min, opt.Max, opt.Step or 1
        local v = opt.Default or mn
        local suffix = opt.Suffix or ""
        local dec = (step < 0.1) and 2 or ((step < 1) and 1 or 0)
        local function fmt(x) return string.format("%." .. dec .. "f", x) .. suffix end
        local function pct(x) return (x - mn) / math.max(1e-9, mx - mn) end
        local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, card)
        lbl(row, opt.Name or "", UDim2.new(1, -90, 0, 14))
        local valL = lbl(row, fmt(v), UDim2.new(0, 86, 0, 14), UDim2.new(1, -86, 0, 0), C.dim, Enum.Font.Gotham, Enum.TextXAlignment.Right)
        local bar = mk("Frame", { Size = UDim2.new(1, 0, 0, 4), Position = UDim2.fromOffset(0, 22), BackgroundColor3 = C.off, BorderSizePixel = 0 }, row)
        rnd(bar, 2)
        local fill = mk("Frame", { Size = UDim2.fromScale(pct(v), 1), BackgroundColor3 = C.on, BorderSizePixel = 0 }, bar)
        rnd(fill, 2)
        local knob = mk("Frame", {
            Size = UDim2.fromOffset(10, 10), AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(pct(v), 0.5), BackgroundColor3 = C.on, BorderSizePixel = 0,
        }, bar)
        rnd(knob, 5)
        local hit = mk("TextButton", {
            Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 14),
            BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
        }, row)
        local dragging = false
        local function set(px)
            local rel = math.clamp((px - bar.AbsolutePosition.X) / math.max(1, bar.AbsoluteSize.X), 0, 1)
            local x = math.floor((mn + (mx - mn) * rel) / step + 0.5) * step
            x = tonumber(string.format("%.4f", math.clamp(x, mn, mx)))
            fill.Size = UDim2.fromScale(pct(x), 1)
            knob.Position = UDim2.fromScale(pct(x), 0.5)
            valL.Text = fmt(x)
            if opt.Callback then opt.Callback(x) end
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                set(i.Position.X)
            end
        end)
        table.insert(uiConns, UIS.InputChanged:Connect(function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                set(i.Position.X)
            end
        end))
        table.insert(uiConns, UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end))
    end

    function sec:Dropdown(opt)
        local opts = opt.Options or {}
        local idx = 1
        for i, o in ipairs(opts) do if o == opt.Default then idx = i end end
        local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, card)
        lbl(row, opt.Name or "", UDim2.new(1, -136, 1, 0))
        local btn = mk("TextButton", {
            Size = UDim2.new(0, 128, 1, 0), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = C.bg, BorderSizePixel = 0, AutoButtonColor = false,
            Text = (opts[idx] or "-") .. "  ▾", TextColor3 = C.text, TextSize = 11,
            Font = Enum.Font.GothamMedium, TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
        rnd(btn, 7); strk(btn)
        btn.MouseButton1Click:Connect(function()
            if #opts == 0 then return end
